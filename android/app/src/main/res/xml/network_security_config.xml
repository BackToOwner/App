<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP by default from API 28 onwards, which would silently break every call
  to the development backend.

  This permits cleartext ONLY for local development addresses rather than switching it off
  globally with android:usesCleartextTraffic="true" — production traffic still has to be HTTPS.
  Add your machine's LAN IP below when testing on a physical device.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>      <!-- Android emulator -> host -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
