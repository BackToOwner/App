PORT=5001
NODE_ENV=development

# ── Shared database ────────────────────────────────────────────────────────
# This is the admin dashboard backend's SQLite file. Both services read and write it, so a report
# filed from the phone appears in the web dashboard and vice versa.
# The path is relative to this folder (App/backend).
DB_PATH=../../Backend/data/admin.sqlite

# Two processes write that file; a colliding write waits this long instead of failing.
DB_BUSY_TIMEOUT_MS=5000

# ── Uploads ────────────────────────────────────────────────────────────────
# Images are stored on disk and referenced from the shared database by relative path
# ("/uploads/x.jpg"). If you want photos uploaded from the phone to render in the admin
# dashboard too, point this at that project's uploads folder instead:
#   UPLOADS_DIR=../../Backend/uploads
UPLOADS_DIR=./uploads

# The base URL a phone can actually reach this server on; used to build absolute image URLs.
# `localhost` on a device means the device itself — use this machine's LAN IP, or
# http://10.0.2.2:5001 from the Android emulator.
PUBLIC_URL=http://localhost:5001

# ── Auth ───────────────────────────────────────────────────────────────────
# Access tokens are short-lived; the refresh token in user_sessions carries the session.
JWT_SECRET=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Only constrains browser callers — the mobile client sends no Origin header.
CORS_ORIGIN=*

# Google Sign-In. Empty = /auth/google returns 503 rather than accepting unverified tokens.
GOOGLE_CLIENT_ID=

# ── Matching ───────────────────────────────────────────────────────────────
DEFAULT_RADIUS_KM=25
MATCH_THRESHOLD=55
MATCH_WINDOW_DAYS=90
# An admin approves matches in the dashboard's own process, so this backend polls for approvals
# rather than being called back. 0 disables the sweep (the app still checks on /me/matches).
MATCH_SWEEP_INTERVAL_MS=30000

# ── Notifications ──────────────────────────────────────────────────────────
# No mail/SMS provider is wired up yet, so OTP codes are logged to the console. Outside production
# they are also returned as `devCode` in the response.
OTP_TTL_MINUTES=15
EXPOSE_OTP_IN_RESPONSE=true

# Firebase Cloud Messaging. Empty = push is logged, not delivered.
FCM_SERVER_KEY=

# Test-suite only; ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=
